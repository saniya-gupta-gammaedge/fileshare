# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Supabase Postgres ───────────────────────────────────
# From: supabase.com → your project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Cloudflare R2 ───────────────────────────────────────
# From: dash.cloudflare.com → R2 → Manage API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=fileshare
R2_PUBLIC_URL=https://pub-xxxx.r2.dev   # optional: if bucket is public

# ── App ─────────────────────────────────────────────────
# Base URL of the frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# Max upload size in bytes (default 100 MB)
MAX_UPLOAD_BYTES=104857600

# Secret used to sign nothing yet — placeholder for future JWT
APP_SECRET=change_me_to_a_random_string
