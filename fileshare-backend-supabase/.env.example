# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Supabase ────────────────────────────────────────────
# From: supabase.com → your project → Settings → API
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # "service_role" key (NOT the anon key)

# ── Supabase Storage ────────────────────────────────────
# Name of the storage bucket you create (see setup below)
SUPABASE_BUCKET=fileshare

# ── App ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_BYTES=104857600    # 100 MB
APP_SECRET=change_me_to_a_random_string

# ── Supabase Storage bucket setup ───────────────────────
# 1. Go to supabase.com → your project → Storage
# 2. Click "New bucket" → name it "fileshare"
# 3. Set it to PRIVATE (backend streams files — browser never hits it directly)
# 4. No other config needed — service_role key bypasses all RLS
